# Copy to infra/.env.backend on the VPS and fill every value. Never commit the filled file.
MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
DB_NAME=qrisgg_production
CORS_ORIGINS=https://qrisgg.com,https://www.qrisgg.com
APP_PUBLIC_URL=https://qrisgg.com
JWT_SECRET=<openssl rand -hex 32>
ENCRYPTION_KEY=<python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())">
ADMIN_EMAIL=<owner email>
ADMIN_PASSWORD=<strong initial password, change after first login>
ADMIN_TOTP_SECRET=<python -c "import pyotp;print(pyotp.random_base32())">
PLATFORM_MODE=SANDBOX
EMERGENT_EMAIL_KEY=<only valid inside Emergent hosting; replace email module with your own provider for self-hosting>
EMAIL_FROM_NAME=Qrisgg
